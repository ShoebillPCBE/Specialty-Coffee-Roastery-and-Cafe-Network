# Copy to .env (which is git-ignored) and fill in locally. NEVER commit real keys.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=llama-3.3-70b-versatile
# Override if command-service / query-service are not containers in this compose file
SERVER_A_URL=http://command-service:8081
SERVER_B_URL=http://query-service:8082
